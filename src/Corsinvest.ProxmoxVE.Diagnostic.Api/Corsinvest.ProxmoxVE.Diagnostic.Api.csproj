<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <Product>Corsinvest for Proxmox VE Diagnostic Api</Product>
    <AssemblyTitle>Corsinvest for Proxmox VE Diagnostic Api</AssemblyTitle>
    <Description>Diagnostic API library for Proxmox VE: checks nodes, VMs, LXC containers and storage for common issues</Description>
    <PackageTags>ProxmoxVE;Api;Client;Rest;Corsinvest;Diagnostic</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Local test feed: every build drops the package in ProxmoxVE\.nupkgs -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>..\..\..\.nupkgs\</PackageOutputPath>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <!-- Symbols: PDB inside the .nupkg (local debugging) and .snupkg for nuget.org -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup >
    <PackageReference Include="Corsinvest.ProxmoxVE.Api.Extension" />
    <!-- <ProjectReference Include="..\..\..\cv4pve-api-dotnet\src\Corsinvest.ProxmoxVE.Api.Extension\Corsinvest.ProxmoxVE.Api.Extension.csproj" /> -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Corsinvest.ProxmoxVE.Diagnostic.Api.Tests" />
  </ItemGroup>
</Project>