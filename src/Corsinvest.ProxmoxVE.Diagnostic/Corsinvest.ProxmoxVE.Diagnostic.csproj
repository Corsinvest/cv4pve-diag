    <ProjectReference Include="..\Corsinvest.ProxmoxVE.Diagnostic.Api\Corsinvest.ProxmoxVE.Diagnostic.Api.csproj" />

    <PackageReference Include="ClosedXML" />
  </ItemGroup>
</Project>