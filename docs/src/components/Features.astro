---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const features = [
  {
    title: 'Cluster-wide in one run',
    text: 'Quorum, HA, replication, backups, firewall, TFA, SMART, ZFS, LVM-thin, snapshots, guest agent, CPU flags, orphaned disks — cluster, nodes, storages, VMs and containers together.',
    href: `${base}/checks/`,
  },
  {
    title: 'Audit evidence, not just alerts',
    text: '100+ findings carry the controls they violate. Filter with --compliance=Nis2 and the report gets a ControlId column ready for your auditor.',
    href: `${base}/compliance/`,
  },
  {
    title: 'Honest about what it cannot see',
    text: 'Proxmox VE silently filters what a token may not read — a guest without VM.Audit simply is not listed. cv4pve-diag checks the privileges first and states in the report what the analysis does not cover.',
    href: `${base}/permissions/`,
  },
  {
    title: 'Tuned to your cluster',
    text: 'Thresholds for CPU, memory, PSI pressure, SMART and health score, plus fast / standard / full profiles and parallel API requests for large clusters.',
    href: `${base}/settings/`,
  },
  {
    title: 'Silence what you accepted',
    text: 'Ignore rules by code, resource, context or severity keep the report focused on what is new — and can still be shown for review.',
    href: `${base}/ignored-issues/`,
  },
  {
    title: 'Every format you need',
    text: 'Text in the terminal, HTML for people, Excel for auditors, JSON and Markdown for automation — from one self-contained binary.',
    href: `${base}/getting-started/`,
  },
];
---

<div class="cv-features not-content">
  {
    features.map((f, i) => (
      <a class="cv-feature" href={f.href}>
        <span class="cv-feature-num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </a>
    ))
  }
</div>

<style>
  .cv-features {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 3rem;
  }
  @media (min-width: 50rem) {
    .cv-features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 72rem) {
    .cv-features {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cv-feature {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--cv-card-border);
    border-radius: 8px;
    background: var(--cv-card-bg);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .cv-feature:hover {
    border-color: var(--cv-blue-bright);
    transform: translateY(-2px);
  }
  .cv-feature-num {
    font-family: var(--cv-font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cv-blue-bright);
  }
  .cv-feature h3 {
    margin: 0.5rem 0;
    font-size: 1.5rem;
    color: var(--sl-color-white);
  }
  .cv-feature p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
