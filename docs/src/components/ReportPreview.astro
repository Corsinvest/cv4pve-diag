---
import { Badge } from '@astrojs/starlight/components';

/*
 * An excerpt of a real report, to explain it on the docs pages: a plain table styled by Starlight,
 * with Starlight badges for the gravity. The command that produces it is a code block in the page.
 *
 * Rows come from a real run (the README example). Columns are the real ones, but reordered to read
 * left to right as "how bad → which control → which check → where → what": the actual text output
 * starts with Id (OutputEngine.CreateTable), as Getting started shows.
 *
 * `standard` shows the output of --compliance=<standard>: only the findings mapped to it, plus the
 * ControlId column (all the controls of that standard in one cell). --compliance takes one standard
 * per run: to show several frameworks, use one preview per standard. `controls` holds the real mapping of each check in the engine — keep it in step
 * with DiagnosticEngine*.cs when a mapping changes.
 */
type Standard = 'Nis2' | 'Iso27001' | 'Dora';

interface Props {
  standard?: Standard;
  /** Include the Ok rows, as a run with --full (IncludeOkResult) does. */
  ok?: boolean;
  /** Show the note under the table. */
  note?: boolean;
  /** Only a sample of each severity (home page). */
  short?: boolean;
}

const { standard, ok = false, note = true, short = false } = Astro.props;

const allRows: {
  id: string;
  code: string;
  text: string;
  context: string;
  sub: string;
  gravity: string;
  controls?: Partial<Record<Standard, string>>;
  /** Reported only with IncludeOkResult: true — shown in the compliance views only. */
  ok?: boolean;
}[] = [
  { id: 'access/users/root@pam', code: 'CC0004', text: 'root@pam has no TFA configured — full access protected only by password', context: 'Cluster', sub: 'Access', gravity: 'Critical',
    controls: { Nis2: 'Art.21(j)', Iso27001: 'A.5.17, A.8.5', Dora: 'Art.9' } },
  { id: 'nodes/pve02/lxc/101', code: 'CG0006', text: 'Privileged container has AppArmor disabled — no kernel confinement, root inside has unrestricted host access', context: 'Lxc', sub: 'Security', gravity: 'Critical',
    controls: { Nis2: 'Art.21(i)', Iso27001: 'A.5.15, A.8.2' } },
  { id: 'nodes/pve02/qemu/203', code: 'CG0002', text: "Disk 'scsi0' disabled for backup", context: 'Qemu', sub: 'Backup', gravity: 'Critical',
    controls: { Nis2: 'Art.21(c)', Iso27001: 'A.8.13', Dora: 'Art.11, Art.12' } },
  { id: 'nodes/pve01/qemu/1104', code: 'WG0026', text: 'Memory (rrd Day Average) usage 93.3% - 10.02 GB of 10.74 GB', context: 'Qemu', sub: 'Usage', gravity: 'Critical' },
  { id: 'nodes/pve01', code: 'WN0013', text: "Node requires reboot: running kernel '6.8.12-20-pve' but newer kernel '6.8.12-43-pve' is installed", context: 'Node', sub: 'Reboot', gravity: 'Warning',
    controls: { Nis2: 'Art.21(e)', Iso27001: 'A.8.8' } },
  { id: 'nodes/pve01/storage/datapool', code: 'WS0002', text: 'Image Orphaned 51.54 GB file vm-106-disk-1', context: 'Storage', sub: 'Image', gravity: 'Warning' },
  { id: 'nodes/pve01/storage/pbs01', code: 'WS0001', text: 'Storage usage 80% - 2.58 TB of 3.22 TB', context: 'Storage', sub: 'Usage', gravity: 'Warning',
    controls: { Iso27001: 'A.5.30, A.8.16', Dora: 'Art.11' } },
  { id: 'nodes/pve02/qemu/106', code: 'WG0003', text: 'Qemu Agent not enabled', context: 'Qemu', sub: 'Agent', gravity: 'Warning' },
  { id: 'nodes/pve01/qemu/1010', code: 'WG0037', text: "CPU type 'kvm64' is missing security flags: +spec-ctrl, +ssbd, +pcid, +md-clear", context: 'Qemu', sub: 'CPU', gravity: 'Warning',
    controls: { Nis2: 'Art.21(e)', Iso27001: 'A.8.8' } },
  { id: 'nodes/pve02/qemu/999', code: 'WG0017', text: 'vzdump backup not configured', context: 'Qemu', sub: 'Backup', gravity: 'Warning',
    controls: { Nis2: 'Art.21(c)', Iso27001: 'A.8.13', Dora: 'Art.11, Art.12' } },
  { id: 'nodes/pve01/qemu/1013', code: 'WG0002', text: "OS 'Microsoft Windows 8.x/2012/2012r2' not maintained from vendor!", context: 'Qemu', sub: 'OSNotMaintained', gravity: 'Warning',
    controls: { Nis2: 'Art.21(e)', Iso27001: 'A.8.8' } },
  { id: 'cluster', code: 'IC0002', text: 'No HA resources configured — VMs will not automatically restart on node failure', context: 'Cluster', sub: 'HA', gravity: 'Info',
    controls: { Nis2: 'Art.21(c)', Iso27001: 'A.5.30', Dora: 'Art.11' } },
  { id: 'nodes/pve02', code: 'IN0001', text: '6 Update available', context: 'Node', sub: 'Update', gravity: 'Info' },
  { id: 'nodes/pve01/qemu/1000', code: 'IG0011', text: 'For production environment is better VM Protection = enabled', context: 'Qemu', sub: 'Protection', gravity: 'Info' },
  // Ok rows. Cluster-level checks give one row; per-guest checks (WG0017) give one row per guest.
  { id: 'cluster/backup', code: 'WC0001', text: '3 backup job(s) configured at cluster level', context: 'Cluster', sub: 'Backup', gravity: 'Ok', ok: true,
    controls: { Nis2: 'Art.21(c)', Iso27001: 'A.8.13', Dora: 'Art.11, Art.12' } },
  { id: 'cluster', code: 'WC0003', text: 'Cluster firewall is enabled', context: 'Cluster', sub: 'Firewall', gravity: 'Ok', ok: true,
    controls: { Nis2: 'Art.21(e)', Iso27001: 'A.8.20, A.8.22' } },
  { id: 'nodes/pve01/qemu/100', code: 'WG0017', text: 'Guest is covered by at least one enabled backup job', context: 'Qemu', sub: 'Backup', gravity: 'Ok', ok: true,
    controls: { Nis2: 'Art.21(c)', Iso27001: 'A.8.13', Dora: 'Art.11, Art.12' } },
  { id: 'nodes/pve01/qemu/101', code: 'WG0017', text: 'Guest is covered by at least one enabled backup job', context: 'Qemu', sub: 'Backup', gravity: 'Ok', ok: true,
    controls: { Nis2: 'Art.21(c)', Iso27001: 'A.8.13', Dora: 'Art.11, Art.12' } },
];

/** Starlight badge variant for each gravity. */
const VARIANT = { Critical: 'danger', Warning: 'caution', Info: 'note', Ok: 'success' } as const;

const SAMPLE = ['CC0004', 'CG0002', 'WN0013', 'WS0001', 'WS0002', 'WG0037', 'IC0002', 'IN0001', 'WC0001', 'WC0003', 'WG0017'];

// The compliance view filters the same rows the plain view shows, as the real --compliance does.
const withOk = ok;
const shown = (short ? allRows.filter((r) => SAMPLE.includes(r.code)) : allRows)
  .filter((r) => withOk || !r.ok);
const rows = standard ? shown.filter((r) => r.controls?.[standard]) : shown;

---

<table class="report">
  <thead>
    <tr>
      <th>Gravity</th>
      {standard && <th>ControlId</th>}
      <th>Code</th><th>Id</th><th>Description</th><th>Context</th><th>SubContext</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <td><Badge text={r.gravity} variant={VARIANT[r.gravity as keyof typeof VARIANT]} /></td>
          {standard && <td><strong>{r.controls?.[standard]}</strong></td>}
          <td><code>{r.code}</code></td>
          <td><code>{r.id}</code></td>
          <td class="desc">{r.text}</td>
          <td>{r.context}</td>
          <td>{r.sub}</td>
        </tr>
      ))
    }
  </tbody>
</table>
{
  withOk && note && (
    <p>
      One row per object: a check failing — or passing — on ten VMs gives ten rows, all the controls of a finding
      in the same row. <code>Ok</code> rows come from <code>--full</code>, or <code>IncludeOkResult: true</code> in the settings file.
    </p>
  )
}

<style>
  /* One line per cell, as in the tool output; only the description wraps. The table scrolls
     sideways on narrow screens (Starlight makes content tables scrollable). */
  .report {
    white-space: nowrap;
  }
  .report td {
    vertical-align: middle;
  }
  .report .desc {
    white-space: normal;
    min-width: 18rem;
  }
</style>
